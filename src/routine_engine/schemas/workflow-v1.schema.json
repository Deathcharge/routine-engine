{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samsarix.com/schemas/routine-engine/workflow-v1.schema.json",
  "title": "Samsarix Routine Engine workflow v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "steps"],
  "properties": {
    "schema_version": {"const": 1, "default": 1},
    "id": {"$ref": "#/$defs/identifier"},
    "description": {"type": "string", "maxLength": 1000, "default": ""},
    "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 32, "default": 4},
    "steps": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/step"}}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "action": {"$ref": "#/$defs/identifier"},
        "needs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}, "default": []},
        "with": {"type": "object", "default": {}},
        "retries": {"type": "integer", "minimum": 0, "maximum": 10, "default": 0},
        "retry_delay_seconds": {"type": "number", "minimum": 0, "maximum": 60, "default": 0}
      }
    }
  }
}
